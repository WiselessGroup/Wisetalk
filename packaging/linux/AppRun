#!/bin/sh
# Starts Wisetalk from its AppImage. As Velopack's own AppRun does, it first
# gives file managers the icon as the AppImage's thumbnail.
if [ -n "$APPIMAGE" ] && [ -n "$APPDIR" ]; then
    MD5=$(printf '%s' "file://$APPIMAGE" | md5sum | cut -d' ' -f1)
    cp "$APPDIR/net.wiseless.wisetalk.png" "$HOME/.cache/thumbnails/normal/$MD5.png" >/dev/null 2>&1
    cp "$APPDIR/net.wiseless.wisetalk.png" "$HOME/.cache/thumbnails/large/$MD5.png" >/dev/null 2>&1
fi
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/bin/wisetalk" "$@"
